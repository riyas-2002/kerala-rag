# ==============================================
# Kerala RAG Backend — Environment Variables
# ==============================================

# --- LLM Provider (choose one) ---
# Groq (recommended — fastest free tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# HuggingFace (fallback)
HF_API_KEY=your_hf_api_key_here
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Active LLM provider: "groq" | "huggingface"
LLM_PROVIDER=groq

# --- Embedding Model ---
# Uses local sentence-transformers (no API needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- FAISS Vector Store ---
FAISS_INDEX_PATH=./data/faiss_index
FAISS_METADATA_PATH=./data/faiss_metadata.pkl

# --- Document Storage ---
DOCUMENTS_PATH=./data/kerala_rag
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Cache ---
CACHE_DIR=./data/cache
CACHE_TTL_SECONDS=3600

# --- App Config ---
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=20
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# --- Retrieval Config ---
TOP_K_CHUNKS=5
SIMILARITY_THRESHOLD=0.35
MAX_CONTEXT_TOKENS=2000

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=20
